#!/bin/sh
: "${MEAD_STUB_LOG:?}"
case "$1" in
  -ver|-version) echo "stub-exiftool-1.0"; exit 0 ;;
esac
printf '%s\0' "$0" "$@" >>"$MEAD_STUB_LOG"
printf '\n' >>"$MEAD_STUB_LOG"
if [ -n "$MEAD_STUB_FAIL_FIRST" ]; then
  flag="${MEAD_STUB_LOG}.failed"
  if [ ! -f "$flag" ]; then
    : >"$flag"
    exit 1
  fi
fi
if [ -n "$MEAD_STUB_EXIFTOOL_FAIL" ] || [ -n "$MEAD_STUB_FAIL" ]; then exit 1; fi
exit 0